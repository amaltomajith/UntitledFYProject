# Copy to .env and fill in. .env is gitignored: never commit it, never paste keys elsewhere.
# Status of each key and where to get it: CLAUDE.md section 4.

# Default provider: Nebius Token Factory, running NVIDIA Nemotron.  https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Optional, free tier: use with --provider groq.  https://console.groq.com
GROQ_API_KEY=

# Optional: lets DocsSearchAgent search the web.  https://tavily.com
TAVILY_API_KEY=

# Optional: only on networks with a TLS-intercepting proxy
# PUPPETEER_CA_BUNDLE=/path/to/ca.pem
